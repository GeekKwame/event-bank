# Copy to .env and fill in. Docker Compose falls back to development defaults for anything unset.
# Never commit .env.

# Django. With DJANGO_DEBUG=false the app refuses to start unless DJANGO_SECRET_KEY is a
# non-placeholder value of 50+ characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Accra
# DJANGO_CSRF_TRUSTED_ORIGINS=https://events.example.org
# DJANGO_BEHIND_TLS_PROXY=true

# Host ports (bound to 127.0.0.1). Change them if they clash with other local services.
BACKEND_HOST_PORT=8000
POSTGRES_HOST_PORT=5432

# PostgreSQL
POSTGRES_DB=event_bank
POSTGRES_USER=event_bank
POSTGRES_PASSWORD=event_bank

# Source connectors
CONNECTOR_USER_AGENT=EventBankBot/0.1
CONNECTOR_CONNECT_TIMEOUT_SECONDS=5
CONNECTOR_READ_TIMEOUT_SECONDS=10
CONNECTOR_TOTAL_TIMEOUT_SECONDS=20
CONNECTOR_MAX_RESPONSE_BYTES=2097152
CONNECTOR_MAX_REDIRECTS=3

# Luma calendar API keys (Luma Plus). Each key grants full access to one calendar.
# Use LUMA_API_KEY, or LUMA_API_KEY_<NAME> together with --config api_key_env=LUMA_API_KEY_<NAME>.
LUMA_API_KEY=

# SMS. Real sending stays off unless SMS_SENDING_ENABLED=true.
# The mNotify sender ID must be registered with mNotify and at most 11 characters.
SMS_SENDING_ENABLED=false
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=

# Telegram. Create your own bot with BotFather; normal broadcasts use the free tier.
# The bot only accepts private-chat commands. No messages are sent unless explicitly enabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SENDING_ENABLED=false

# The worker only fetches approved sources. Enable after reviewing their access/reuse rules.
INGESTION_SCHEDULING_ENABLED=false
INGESTION_INTERVAL_SECONDS=3600
# Sources ingested per worker cycle; keeps Telegram polling and delivery responsive.
INGESTION_SOURCES_PER_CYCLE=2

# Finished deliveries, /add attempts and dormant subscribers are deleted after this many days.
DATA_RETENTION_DAYS=30

# Number of trusted reverse proxies in front of the app (for API throttling by client IP).
# Leave unset when there is no proxy, as in local development.
# API_NUM_PROXIES=1
